# Environment for the staging container ONLY.
#
# The point of staging is to exercise `kukansite.settings.prod` — the module
# that refuses to start when anything is missing. Doing that needs a complete
# set of variables, so here is one, entirely made of obvious fakes.
#
# Nothing in this file is a secret and nothing in it reaches a real service:
# the Dropbox token and the AnkiWeb passwords are junk, and the container has
# no cron, so the nightly jobs that would use them never run. The database is
# a scrubbed copy; the entrypoint refuses to start if it is not.
#
# Production's real values live in /etc/kukan/kukan.env, which is not in this
# repository. See deploy/kukan.env.example for its shape.

# Deterministic and worthless. Sessions do not survive a rebuild, which is
# what you want from staging.
DJANGO_SECRET_KEY=staging-only-not-a-secret-do-not-reuse
DJANGO_SECRET_KEY_FALLBACKS=

# The container publishes 8443 on the host loopback.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443

DROPBOX_TOKEN=staging-fake-dropbox-token

# Not the production key. The sensor is not pointed at staging, and if it ever
# were, this makes it fail the API_KEY check rather than write test data into a
# real-looking session.
TEMPMON_API_KEY=staging-fake-api-key

ANKI_AYUMI_USER=staging@example.invalid
ANKI_AYUMI_PASSWORD=staging-fake
ANKI_FRED_USER=staging@example.invalid
ANKI_FRED_PASSWORD=staging-fake
ANKI_TEST2_USER=staging@example.invalid
ANKI_TEST2_PASSWORD=staging-fake

LETSENCRYPT_ROOT=/opt/kukan/letsencrypt
KUKAN_WEBROOT=/opt/kukan/
