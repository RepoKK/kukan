# Production environment for kukanjiten.com.
#
# INSTALL AS:  /etc/kukan/kukan.env   owner root:kukan   mode 0640
#
#   sudo install -d -o root -g kukan -m 0750 /etc/kukan
#   sudo install -o root -g kukan -m 0640 kukan.env.example /etc/kukan/kukan.env
#   sudo -e /etc/kukan/kukan.env      # fill in the real values
#
# Loaded by the web process and, via `manage.py set_cron`, by the nightly jobs.
# The syntax is deliberately plain `KEY=value` with no quoting or expansion, so
# that `set -a; . /etc/kukan/kukan.env; set +a` and systemd's EnvironmentFile
# both read it identically. Do not add shell constructs.
#
# Every variable without a default is REQUIRED: kukansite/settings/prod.py
# raises ImproperlyConfigured and the process refuses to start without it.
# That is intentional — see the module docstring for what it replaced.

# --- Django core -------------------------------------------------------------

# Generate with:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
DJANGO_SECRET_KEY=

# Comma-separated. Used for one deploy while rotating DJANGO_SECRET_KEY, then
# emptied. Sessions signed with a listed key keep working, so rotation does not
# log everyone out.
#
# NOTE: the key that shipped in git history is burned. Put it here for the
# first deploy of this stage, then remove it on the second.
DJANGO_SECRET_KEY_FALLBACKS=

DJANGO_ALLOWED_HOSTS=kukanjiten.com,www.kukanjiten.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://kukanjiten.com,https://www.kukanjiten.com

# --- Credentials -------------------------------------------------------------

# Dropbox app token used by the nightly backup_db job.
DROPBOX_TOKEN=

# Shared secret the temperature sensor puts in the JSON body as API_KEY.
# CHANGING THIS BREAKS THE SENSOR: its firmware is not in this repository and
# has no retry buffer, so anything it fails to deliver is lost. Only change it
# in step with reflashing the device.
TEMPMON_API_KEY=

# --- AnkiWeb accounts --------------------------------------------------------
# Used by the nightly sync_anki job.

ANKI_AYUMI_USER=
ANKI_AYUMI_PASSWORD=
ANKI_FRED_USER=
ANKI_FRED_PASSWORD=
ANKI_TEST2_USER=
ANKI_TEST2_PASSWORD=

# --- Paths -------------------------------------------------------------------
# Previously hard-coded to /home/fred in settings.py.

LETSENCRYPT_ROOT=/home/fred/letsencrypt
KUKAN_WEBROOT=/home/fred/kukan/
